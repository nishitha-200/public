SELECT s.student_id, s.name AS student_name, c.course_name,
       e.enrollment_date, e.status
FROM student s
JOIN enrollment e ON s.student_id=e.student_id
JOIN course c ON e.course_id=c.course_id;

SELECT c.course_name, t.name AS trainer_name, t.specialization
FROM course c
JOIN trainer t ON c.trainer_id=t.trainer_id;

SELECT e.enrollment_id, s.name AS student_name, c.course_name,
       p.amount, p.payment_method, p.payment_status
FROM enrollment e
JOIN student s ON e.student_id=s.student_id
JOIN course c ON e.course_id=c.course_id
JOIN payment p ON e.enrollment_id=p.enrollment_id;

SELECT course_name, fee
FROM course
WHERE fee > (SELECT AVG(fee) FROM course);

DROP VIEW IF EXISTS student_course_details;
CREATE VIEW student_course_details AS
SELECT s.student_id, s.name AS student_name, c.course_name,
       t.name AS trainer_name, e.enrollment_date, e.status
FROM student s
JOIN enrollment e ON s.student_id=e.student_id
JOIN course c ON e.course_id=c.course_id
JOIN trainer t ON c.trainer_id=t.trainer_id;

SELECT * FROM student_course_details;

DROP PROCEDURE IF EXISTS get_student_courses;
DELIMITER $$
CREATE PROCEDURE get_student_courses(IN p_student_id INT)
BEGIN
    SELECT s.name AS student_name, c.course_name,
           e.enrollment_date, e.status
    FROM student s
    JOIN enrollment e ON s.student_id=e.student_id
    JOIN course c ON e.course_id=c.course_id
    WHERE s.student_id=p_student_id;
END $$
DELIMITER ;

CALL get_student_courses(1);